{
  "name": "tg-relay-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/tg-relay-worker/src",
  "tags": ["profile:a", "scope:backend", "runtime:cloudflare-worker"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "esbuild src/index.ts --bundle --outfile=../../dist/services/tg-relay-worker/index.js --format=esm --target=es2022",
        "cwd": "services/tg-relay-worker"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "services/tg-relay-worker"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "services/tg-relay-worker"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "services/tg-relay-worker"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/audit-runner.py --scope services/tg-relay-worker"
      }
    }
  }
}
