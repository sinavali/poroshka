{
  "name": "core-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/core-api/src",
  "tags": ["profile:a", "scope:backend"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "options": {
        "outputPath": "dist/services/core-api",
        "main": "services/core-api/src/bootstrap/main.ts",
        "tsConfig": "services/core-api/tsconfig.app.json",
        "target": "node22",
        "bundle": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Core API lint passed'",
        "cwd": "services/core-api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "services/core-api"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "services/core-api"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/audit-runner.py --scope services/core-api"
      }
    }
  }
}
