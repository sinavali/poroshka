# Promptjoo Environment Configuration

# Application Environment ('development' | 'production')
NODE_ENV=development

# Database Configuration (PostgreSQL 16+ with pgvector)
# Dedicated isolated database 'poroshka_db'
DATABASE_URL=postgresql://localhost:5432/poroshka_db

# Redis Cache & Rate-Limiting Configuration
# Dedicated isolated logical database (e.g. database index 1 with 'poroshka:' prefix)
REDIS_URL=redis://localhost:6379/0

# Port Allocation
PORT=3000
INTERNAL_API_PORT=4000
INTERNAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=

# Superadmin & Identity
ADMIN_PHONE=+989123456789
ADMIN_PASSWORD=SuperSecretPromptjoo2026!
SUPERADMIN_TOKEN=promptjoo-super-secret-admin-token
ALTCHA_HMAC_SECRET=promptjoo-altcha-development-hmac-secret-key-32b
RELAY_SECRET=promptjoo-tg-relay-development-secret-key

# SMS & AI Gateways (optional in dev)
MELIPAYAMAK_API_KEY=
GEMINI_API_KEY=
