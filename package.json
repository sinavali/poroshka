{
  "name": "poroshka",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Enterprise multi-modal AI prompt platform with zero runtime LLM cost (Poroshka)",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinavali/poroshka.git"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "nx": "nx",
    "start": "node scripts/start-all.js",
    "dev": "node scripts/start-all.js --dev",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "audit": "nx run-many -t audit",
    "dataset:export": "node scripts/export-dataset.js",
    "dataset:import": "node scripts/import-dataset.js",
    "runflare:deploy": "bash scripts/deploy-unified-docker.sh",
    "verify": "python3 scripts/verify-nx-targets.py --root . && python3 scripts/verify-agent-manifests.py --root . && python3 scripts/check-nc-items.py --dir docs/nc --max-age 14 && python3 scripts/validate-change-surface.py CHANGE_SURFACE.md && python3 scripts/audit-runner.py --scope ."
  },
  "devDependencies": {
    "@nx/devkit": "^23.3.0",
    "@nx/esbuild": "^23.3.0",
    "@nx/js": "^23.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ioredis": "^5.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "nx": "^23.3.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@hono/node-server": "^2.1.5",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.24.2"
  }
}
