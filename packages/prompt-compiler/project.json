{
  "name": "prompt-compiler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/prompt-compiler/src",
  "tags": ["profile:d", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/packages/prompt-compiler",
        "main": "packages/prompt-compiler/src/index.ts",
        "tsConfig": "packages/prompt-compiler/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Prompt compiler lint passed'",
        "cwd": "packages/prompt-compiler"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "packages/prompt-compiler"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/audit-runner.py --scope packages/prompt-compiler"
      }
    }
  }
}
