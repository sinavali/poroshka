{
  "name": "persian-normalizer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/persian-normalizer/src",
  "tags": ["profile:d", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/packages/persian-normalizer",
        "main": "packages/persian-normalizer/src/index.ts",
        "tsConfig": "packages/persian-normalizer/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "coverage": true
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/audit-runner.py --scope packages/persian-normalizer"
      }
    }
  }
}
