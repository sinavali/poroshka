{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mobile/src",
  "tags": ["profile:c", "scope:mobile"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/mobile && npx react-native build-android --mode=release"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "coverage": true
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/audit-runner.py --scope apps/mobile"
      }
    }
  }
}
