{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["profile:b", "scope:frontend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist-next"],
      "options": {
        "command": "NODE_ENV=production next build",
        "cwd": "apps/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "apps/web"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tests/*.spec.ts",
        "cwd": "apps/web"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/audit-runner.py --scope apps/web"
      }
    }
  }
}
