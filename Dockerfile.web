# Production Multi-Stage Dockerfile for Promptjoo Next.js Web on Runflare
# Stage 1: Build
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install native dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Enable and prepare pnpm
RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

# Copy workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json ./
COPY packages ./packages
COPY apps/web ./apps/web

# Install all workspace dependencies deterministically
RUN pnpm install --frozen-lockfile

# Build internal shared packages first
RUN pnpm --filter @promptjoo/contracts run build && \
    pnpm --filter @promptjoo/persian-normalizer run build && \
    pnpm --filter @promptjoo/prompt-compiler run build

# Build Next.js Web Application in Standalone Mode
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm --filter @promptjoo/web run build

# Stage 2: Minimal Lightweight Runner
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output from builder
COPY --from=builder /app/apps/web/dist-next/standalone ./
COPY --from=builder /app/apps/web/dist-next/static ./apps/web/dist-next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER nextjs

EXPOSE 3000

WORKDIR /app/apps/web
CMD ["node", "server.js"]
